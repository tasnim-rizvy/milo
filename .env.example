# Optional — Milo runs fully scripted without any keys (the demo path).
# Provide either/both for generative warmth (free tiers, no card):
# GEMINI_API_KEY=...        # https://aistudio.google.com  (Gemini Flash, free tier)
# GEMINI_MODEL=gemini-flash-latest
# GROQ_API_KEY=...          # https://console.groq.com     (GPT-OSS, free tier)
# GROQ_MODEL=openai/gpt-oss-120b

# Ladder order — try Groq first if your network reaches it faster than Gemini:
# LLM_PRIORITY=groq,gemini

# PORT=3001
# HOST=0.0.0.0
# DB_PATH=./server/data/milo.db
